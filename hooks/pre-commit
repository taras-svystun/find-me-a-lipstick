#!/bin/sh
# Runs pytest on exactly what is being committed (the index), not on the working tree.
# A commit that touches only tests/ must FAIL its tests: that is the "tests first" commit,
# and a test that already passes before its code exists checks nothing new.
# Any other commit must pass. Skip once, with a reason in the body: git commit --no-verify
repo=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0
tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX") || exit 1  # macOS mktemp ignores TMPDIR without a template
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
# the copy has no models/ folder: use the repo's downloaded models
export HF_HOME="${HF_HOME:-$repo/models}"
cd "$tmp" && "$repo/.venv/bin/pytest" -q -p no:cacheprovider > "$tmp/.out" 2>&1
status=$?
tail -3 "$tmp/.out"
if [ -z "$(echo "$staged" | grep -v '^tests/')" ]; then
  [ $status -ne 0 ] && { echo "pre-commit: tests-only commit, tests fail as they should"; exit 0; }
  echo "pre-commit: tests-only commit, but the tests already pass: they check nothing new"; exit 1
fi
[ $status -eq 0 ] && exit 0
echo "pre-commit: tests fail on the staged files"; exit 1
